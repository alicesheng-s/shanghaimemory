<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/shBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/txt_onb_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:textColor="?attr/shTextMuted"
            android:text="1 / 5" />

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/onb_skip"
            android:textSize="13sp"
            android:textColor="?attr/shTextMuted" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/page_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/page1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_menu_onboarding" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/onb_p1_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/onb_p1_1"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/onb_p1_2"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/onb_p1_3"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shAccent" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/page2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_p2_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p2_lead"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.55"
                    android:textColor="?attr/shTextMuted" />

                <EditText
                    android:id="@+id/et_key"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_card"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:hint="@string/onb_p2_hint"
                    android:textSize="14sp"
                    android:inputType="textVisiblePassword"
                    android:importantForAutofill="no"
                    android:maxLines="1"
                    android:textColor="?attr/shText"
                    android:textColorHint="?attr/shTextMuted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p2_help"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/shTextMuted" />

                <TextView
                    android:id="@+id/txt_key_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:textColor="?attr/shOk" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/page3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_p3_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p3_lead"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.55"
                    android:textColor="?attr/shTextMuted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/pick_ink_gold"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="sh:keep_color"
                            android:text="&#9679;"
                            android:textSize="20sp"
                            android:textColor="@color/amber" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/onb_p3_ink_gold"
                            android:textSize="12sp"
                            android:textColor="?attr/shText" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pick_sakura"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="sh:keep_color"
                            android:text="&#9679;"
                            android:textSize="20sp"
                            android:textColor="@color/sakura_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/onb_p3_sakura"
                            android:textSize="12sp"
                            android:textColor="?attr/shText" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pick_celadon"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="sh:keep_color"
                            android:text="&#9679;"
                            android:textSize="20sp"
                            android:textColor="@color/celadon_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/onb_p3_celadon"
                            android:textSize="12sp"
                            android:textColor="?attr/shText" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/onb_p3_light"
                    android:textSize="13sp"
                    android:textColor="?attr/shTextMuted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/light_follow"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_card"
                        android:text="@string/light_follow"
                        android:textSize="13sp"
                        android:textColor="?attr/shText" />

                    <TextView
                        android:id="@+id/light_on"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/bg_card"
                        android:text="@string/light_on"
                        android:textSize="13sp"
                        android:textColor="?attr/shText" />

                    <TextView
                        android:id="@+id/light_off"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/bg_card"
                        android:text="@string/light_off"
                        android:textSize="13sp"
                        android:textColor="?attr/shText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_onb_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:text="@string/onb_p3_preview"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:tag="sh:prose"
                    android:textColor="?attr/shText" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/page4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_p4_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/onb_p4_1"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p4_2"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p4_3"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p4_4"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:padding="13dp"
                    android:text="@string/onb_p4_note"
                    android:textSize="12.5sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/shTextMuted" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/page5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_p5_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/onb_p5_1"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p5_2"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p5_3"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_p5_4"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="?attr/shText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:padding="13dp"
                    android:text="@string/onb_p5_note"
                    android:textSize="12.5sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/shTextMuted" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/dot_1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_spot_add" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_spot_add" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_spot_add" />

        <View
            android:id="@+id/dot_4"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_spot_add" />

        <View
            android:id="@+id/dot_5"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_spot_add" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_next"
        style="@style/Button.Amber"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:text="@string/onb_next"
        android:textSize="15sp" />
</LinearLayout>