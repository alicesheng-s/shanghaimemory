<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/shBg">

    <com.amap.api.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="?attr/shScrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:tint="?attr/shAccent"
            android:contentDescription="打开侧栏"
            android:src="@drawable/ic_menu" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="不一样的上海记忆"
                android:textColor="?attr/shText"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_status"
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/map_hint_idle" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/cursor"
        android:alpha="0.72"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:contentDescription="当前游标位置"
        android:src="@drawable/cursor_pin" />

    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_button"
            android:tint="?attr/shAccent"
            android:contentDescription="@string/search_title"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btn_route"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_button"
            android:tint="?attr/shAccent"
            android:contentDescription="@string/route_title"
            android:src="@drawable/ic_route" />

        <ImageButton
            android:id="@+id/btn_chat"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_button"
            android:tint="?attr/shAccent"
            android:contentDescription="@string/chat_title"
            android:src="@drawable/ic_chat" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_button"
            android:tint="?attr/shAccent"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/route_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="178dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_route_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/shAccentBright"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_route_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="结束"
                android:textColor="?attr/shTextMuted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_route_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/shText"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_route_dist"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txt_poi_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="拖动地图，找到你想听的地方"
            android:textColor="?attr/shText"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_poi_meta"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="上海 · 等待定位" />

        <TextView
            android:id="@+id/txt_alt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/shAccentBright"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_story"
            style="@style/Button.Amber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/map_learn_more" />
    </LinearLayout>

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/shScrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="292dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/shBgRaise"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="不一样的上海记忆"
            android:textColor="?attr/shText"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_drawer_palette"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/btn_drawer_chat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="记忆对话"
            android:textColor="?attr/shText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_drawer_route"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="游览路线"
            android:textColor="?attr/shText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_drawer_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="设置"
            android:textColor="?attr/shText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_drawer_clear_route"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="结束当前路线"
            android:textColor="?attr/shTextMuted"
            android:textSize="16sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="对话与路线保存在本次运行的内存里，退出应用后清空。API Key 只存在本机。" />
    </LinearLayout>

</FrameLayout>
