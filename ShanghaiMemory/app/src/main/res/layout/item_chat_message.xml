<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/txt_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:textColor="?attr/shTextMuted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/mark_bar"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="?attr/shAccent" />

        <TextView
            android:id="@+id/txt_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.55"
            android:textColor="?attr/shText"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_sources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.35"
        android:textColor="?attr/shTextMuted"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
