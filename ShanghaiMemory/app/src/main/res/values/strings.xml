    <string name="route_preset_title">预设路线</string>
    <string name="route_theme_power">电力之旅</string>
    <string name="route_theme_power_desc">从 1882 年的电灯到 1913 年的烟囱，串联电厂、水厂、仓库与电力学府。</string>
    <string name="route_theme_industry">工业之旅</string>
    <string name="route_theme_industry_desc">船坞、纱厂、筒仓、糖厂、宰牲场与邮局，黄浦江与苏州河两岸的生产现场。</string>
    <string name="route_custom_title">自定义路线</string>
    <string name="route_custom_hint">明确两件事：想探索什么话题，以及更偏爱正在举办的活动还是老建筑本身。</string>
    <string name="route_custom_keywords">关键词</string>
    <string name="route_custom_keywords_hint">例如：纱厂 or 纺织 and 苏州河</string>
    <string name="route_custom_logic_hint">支持用 and（同时满足）、or（满足其一）、not（排除）及括号组合，也可直接输入一句自然语言。</string>
    <string name="route_custom_prefer">内容偏好</string>
    <string name="route_pref_event">近期活动：优先推荐仍在开放、正在办展或有活动的场所</string>
    <string name="route_pref_history">历史建筑：优先推荐有年头、能看出原有用途的老建筑</string>
    <string name="route_pref_both">都行：老建筑与当下正在发生的活动各占一半</string>
