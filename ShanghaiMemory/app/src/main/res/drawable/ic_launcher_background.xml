<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深墨夜色径向底图：中心微暖蓝墨过渡到四周沉稳暗夜 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="68"
                android:startColor="#1E2738"
                android:centerColor="#131924"
                android:endColor="#0A0D12" />
        </aapt:attr>
    </path>

    <!-- 城市经纬与指南针微光环（极低饱和，托起前景徽标层次） -->
    <path
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0"
        android:strokeColor="#222C3D"
        android:strokeWidth="0.9"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,54m-33,0a33,33 0,1 1,66 0a33,33 0,1 1,-66 0"
        android:strokeColor="#1B2331"
        android:strokeWidth="0.8"
        android:fillColor="#00000000" />

    <!-- 黄浦江天际锯齿厂房极淡剪影 -->
    <path
        android:pathData="M0,78 L14,78 L14,68 L24,73 L24,68 L34,73 L34,78 L74,78 L74,69 L83,74 L83,69 L93,74 L93,78 L108,78 L108,108 L0,108 Z"
        android:fillColor="#111620" />

    <!-- 底部江水暗金光泽过渡 -->
    <path android:pathData="M0,84h108v24h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="84"
                android:endX="54"
                android:endY="108"
                android:startColor="#0E141E"
                android:endColor="#080B10" />
        </aapt:attr>
    </path>
</vector>
