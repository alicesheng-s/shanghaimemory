        <path
            android:pathData="M54,24.5 L56.2,28.5 L51.8,28.5 Z"
            android:fillColor="#F5DBA3" />
        <path
            android:pathData="M31.5,49 L34.5,49 M73.5,49 L76.5,49"
            android:strokeColor="#8E7550"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />

