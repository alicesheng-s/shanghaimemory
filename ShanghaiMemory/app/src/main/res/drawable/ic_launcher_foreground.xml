        <path
            android:pathData="M40.5,67.6 Q47,65.2 53.5,67.6 T67.5,67.6"
            android:strokeColor="#C8A66B"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

