            android:strokeWidth="2.7">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="34"
                    android:startY="22"
                    android:endX="74"
                    android:endY="85"
                    android:startColor="#F5DBA3"
                    android:centerColor="#C8A66B"
                    android:endColor="#8E6C36" />
            </aapt:attr>
